#!/usr/bin/env bash
# ABOUTME: Installs the packages in packages/arch.txt and packages/aur.txt through omarchy,
# ABOUTME: symlinks this repo's stow packages into $HOME with GNU stow, then registers the guard hook.

set -u

# Stow packages (top-level dirs of this repo) linked into $HOME, in order.
stow_packages=(claude)

usage() {
  cat <<'EOF'
install — install this repo's packages on Omarchy

Usage: ./install [-h | --help]

Reads package names from two lists next to this script:
  packages/arch.txt  passed to `omarchy pkg add`
  packages/aur.txt   passed to `omarchy pkg aur add`
One name per line; blank lines and anything after `#` are ignored.
A list with no names is skipped. Both commands skip installed packages
and prompt for sudo when something is missing.

Then links the stow packages (claude) into $HOME:
  stow --no-folding -d <this repo> -t $HOME <packages>
--no-folding links each file and makes real directories, so apps that
write into ~/.claude never write into the repo. Re-running is safe.

If a real file already sits where a link should go, stow reports the
conflict and changes nothing. Move that file aside by hand, then re-run.
This script never overwrites or adopts your files.

Last, registers the guard hook in ~/.claude/settings.json with jq, as a
PreToolUse entry for Bash whose command is the hook's absolute path.
If any PreToolUse command already ends in /.claude/hooks/guard-commands.sh,
the file is left as is. Otherwise the entry is appended, keeping every
other key and hook; a missing file is created. The new file is written
next to the old one, then moved over it.

Exits nonzero if omarchy isn't on PATH, a list is missing, an omarchy
call fails, stow or jq isn't on PATH after the package step, stow fails,
or settings.json isn't a valid JSON object (it is left untouched).
EOF
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  "") ;;
  *) printf 'install: unknown argument: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac

die() {
  printf 'install: %s\n' "$1" >&2
  exit 1
}

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
arch_list="$here/packages/arch.txt"
aur_list="$here/packages/aur.txt"

command -v omarchy >/dev/null || die "omarchy not found on PATH; this script needs Omarchy."
for list in "$arch_list" "$aur_list"; do
  [ -f "$list" ] || die "package list not found: $list"
done

# read_list <file> — prints one package name per line, dropping comments, blanks and
# surrounding whitespace. Handles a last line with no newline.
read_list() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] && printf '%s\n' "$line"
  done <"$1"
}

# install_list <file> <omarchy args...> — runs `omarchy <args...> <names>` unless the list is empty.
install_list() {
  local list="$1" names
  shift
  mapfile -t names < <(read_list "$list")
  [ "${#names[@]}" -gt 0 ] || return 0
  omarchy "$@" "${names[@]}" || die "omarchy $* failed for $list"
}

install_list "$arch_list" pkg add
install_list "$aur_list" pkg aur add

# stow comes from packages/arch.txt, so check for it only after the package step.
command -v stow >/dev/null || die "stow not found on PATH; add stow to packages/arch.txt and re-run."
stow --no-folding -d "$here" -t "$HOME" "${stow_packages[@]}" \
  || die "stow failed for: ${stow_packages[*]}. If it reported conflicts, nothing was linked: move each file it names aside by hand (e.g. mv ~/.claude/CLAUDE.md ~/.claude/CLAUDE.md.bak), then re-run ./install."

# register_hook — adds the guard hook to $HOME/.claude/settings.json unless a PreToolUse
# entry already runs it. Writes to a temp file in the same dir, then mv, so a failed
# write never leaves a half-written settings.json.
register_hook() {
  local settings="$HOME/.claude/settings.json" hook="$HOME/.claude/hooks/guard-commands.sh" tmp
  local registered='any(.hooks.PreToolUse[]?.hooks[]?.command; type == "string" and endswith("/.claude/hooks/guard-commands.sh"))'
  local append='.hooks.PreToolUse += [{matcher: "Bash", hooks: [{type: "command", command: $hook}]}]'

  if [ -e "$settings" ]; then
    jq -e 'type == "object"' "$settings" >/dev/null \
      || die "$settings is not a valid JSON object; left it untouched. Fix it by hand, then re-run."
    jq -e "$registered" "$settings" >/dev/null 2>&1 && return 0
  fi

  tmp="$settings.install-$$"
  if [ -e "$settings" ]; then
    jq --arg hook "$hook" "$append" "$settings" >"$tmp" && chmod --reference="$settings" "$tmp"
  else
    jq -n --arg hook "$hook" "{} | $append" >"$tmp"
  fi || { rm -f "$tmp"; die "could not write the guard hook entry to $settings"; }
  mv "$tmp" "$settings" || { rm -f "$tmp"; die "could not replace $settings"; }
}

# jq comes from packages/arch.txt, so check for it only after the package step.
command -v jq >/dev/null || die "jq not found on PATH; add jq to packages/arch.txt and re-run."
register_hook
