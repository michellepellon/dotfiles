#!/usr/bin/env bash
# ABOUTME: Installs this repo's package lists (omarchy on Omarchy, Homebrew on macOS), symlinks
# ABOUTME: its stow packages into $HOME, and sets up Claude Code: guard hook, plugins, MCP servers.

set -u

# Stow packages (top-level dirs of this repo) linked into $HOME, in order.
stow_packages=(claude)

usage() {
  cat <<'EOF'
install — install this repo's packages on Omarchy or macOS

Usage: ./install [-h | --help]

Reads package names from two lists next to this script, picked by
`uname -s`. On Omarchy (Linux):
  packages/arch.txt  passed to `omarchy pkg add`
  packages/aur.txt   passed to `omarchy pkg aur add`
On macOS (Darwin):
  packages/brew.txt  passed to `brew install`
  packages/cask.txt  passed to `brew install --cask`
One name per line; blank lines and anything after `#` are ignored.
A list with no names is skipped. All four commands skip installed
packages. omarchy prompts for sudo when something is missing; so may
a cask. The other system's lists are never read.

Then links the stow packages (claude) into $HOME:
  stow --no-folding -d <this repo> -t $HOME <packages>
--no-folding links each file and makes real directories, so apps that
write into ~/.claude never write into the repo. Re-running is safe.

If a real file already sits where a link should go, stow reports the
conflict and changes nothing. Move that file aside by hand, then re-run.
This script never overwrites or adopts your files.

Next, registers the guard hook in ~/.claude/settings.json with jq, as a
PreToolUse entry for Bash whose command is the hook's absolute path.
If any PreToolUse command already ends in /.claude/hooks/guard-commands.sh,
the file is left as is. Otherwise the entry is appended, keeping every
other key and hook; a missing file is created. The new file is written
next to the old one, then moved over it.

Then creates ~/.claude/local.md, a stub for facts about this machine
only, unless something is already there. ~/.claude/CLAUDE.md imports
that file; the dotfiles don't track it, so each machine keeps its own.

Next, installs the Claude Code plugins in packages/claude-plugins.txt,
on either system. Each line holds `<plugin> <marketplace>`; blank lines
and anything after `#` are ignored. Checks every line first, then runs
this for each one, in file order:
  claude plugin install <plugin> --marketplace <marketplace> --scope user
claude skips an installed plugin and adds a marketplace it doesn't know
yet, so re-running is safe. For some plugins it shows a command and
waits for you to confirm it. A list with no plugins is skipped, and
then claude needn't be on PATH.

Last, registers the MCP servers in packages/claude-mcp.txt, on either
system. Each line holds `<name> <command> [args...]` and is split on
whitespace, with no quoting; blank lines and anything after `#` are
ignored. Checks every line first. Then, for each one in file order,
stops if <command> isn't on PATH, skips a name that
`claude mcp get <name>` already finds, and otherwise runs:
  claude mcp add --scope user <name> -- <command> [args...]
claude keeps these servers in ~/.claude.json. A list with no servers is
skipped, and then claude needn't be on PATH.

Exits nonzero if the system is neither Linux nor Darwin, its package
manager (omarchy or brew) isn't on PATH, a list is missing, a package
call fails, stow or jq isn't on PATH after the package step, stow fails,
settings.json isn't a valid JSON object (it is left untouched), local.md
can't be written, a plugin line doesn't hold two fields, an MCP line
holds only one, claude isn't on PATH when either list has entries, a
server's command isn't on PATH, or a plugin or `mcp add` call fails.
EOF
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  "") ;;
  *) printf 'install: unknown argument: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac

die() {
  printf 'install: %s\n' "$1" >&2
  exit 1
}

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Each system has a package manager and two lists: main_list holds what its plain install
# command takes (and must provide stow and jq), extra_list what the second command takes.
os="$(uname -s)"
case "$os" in
  Linux)
    manager=omarchy
    main_list="$here/packages/arch.txt"
    extra_list="$here/packages/aur.txt"
    main_cmd=(omarchy pkg add)
    extra_cmd=(omarchy pkg aur add)
    ;;
  Darwin)
    manager=brew
    main_list="$here/packages/brew.txt"
    extra_list="$here/packages/cask.txt"
    main_cmd=(brew install)
    extra_cmd=(brew install --cask)
    ;;
  *) die "unsupported system: $os. This script runs on Omarchy (Linux) and macOS (Darwin)." ;;
esac

# Claude Code plugins and MCP servers are the same on both systems, so each has one list.
plugin_list="$here/packages/claude-plugins.txt"
mcp_list="$here/packages/claude-mcp.txt"

command -v "$manager" >/dev/null || die "$manager not found on PATH; on $os this script needs it."
for list in "$main_list" "$extra_list" "$plugin_list" "$mcp_list"; do
  [ -f "$list" ] || die "package list not found: $list"
done

# read_list <file> — prints one list entry per line, dropping comments, blanks and
# surrounding whitespace. Handles a last line with no newline.
read_list() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] && printf '%s\n' "$line"
  done <"$1"
}

# install_list <file> <command...> — runs `<command...> <names>` unless the list is empty.
# Reads with a loop, not mapfile: macOS ships bash 3.2, which has no mapfile.
install_list() {
  local list="$1" names=() name
  shift
  while IFS= read -r name; do names+=("$name"); done < <(read_list "$list")
  [ "${#names[@]}" -gt 0 ] || return 0
  "$@" "${names[@]}" || die "$* failed for $list"
}

install_list "$main_list" "${main_cmd[@]}"
install_list "$extra_list" "${extra_cmd[@]}"

# stow comes from the main list, so check for it only after the package step.
command -v stow >/dev/null || die "stow not found on PATH; add stow to $main_list and re-run."
stow --no-folding -d "$here" -t "$HOME" "${stow_packages[@]}" \
  || die "stow failed for: ${stow_packages[*]}. If it reported conflicts, nothing was linked: move each file it names aside by hand (e.g. mv ~/.claude/CLAUDE.md ~/.claude/CLAUDE.md.bak), then re-run ./install."

# register_hook — adds the guard hook to $HOME/.claude/settings.json unless a PreToolUse
# entry already runs it. Writes to a temp file in the same dir, then mv, so a failed
# write never leaves a half-written settings.json. The temp file starts as a `cp -p` of
# the old one, which keeps its mode on both GNU and BSD.
register_hook() {
  local settings="$HOME/.claude/settings.json" hook="$HOME/.claude/hooks/guard-commands.sh" tmp
  local registered='any(.hooks.PreToolUse[]?.hooks[]?.command; type == "string" and endswith("/.claude/hooks/guard-commands.sh"))'
  # shellcheck disable=SC2016 # $hook is a jq variable (--arg), not a shell one.
  local append='.hooks.PreToolUse += [{matcher: "Bash", hooks: [{type: "command", command: $hook}]}]'

  if [ -e "$settings" ]; then
    jq -e 'type == "object"' "$settings" >/dev/null \
      || die "$settings is not a valid JSON object; left it untouched. Fix it by hand, then re-run."
    jq -e "$registered" "$settings" >/dev/null 2>&1 && return 0
  fi

  tmp="$settings.install-$$"
  if [ -e "$settings" ]; then
    cp -p "$settings" "$tmp" && jq --arg hook "$hook" "$append" "$settings" >"$tmp"
  else
    jq -n --arg hook "$hook" "{} | $append" >"$tmp"
  fi || { rm -f "$tmp"; die "could not write the guard hook entry to $settings"; }
  mv "$tmp" "$settings" || { rm -f "$tmp"; die "could not replace $settings"; }
}

# jq comes from the main list, so check for it only after the package step.
command -v jq >/dev/null || die "jq not found on PATH; add jq to $main_list and re-run."
register_hook

# The stowed CLAUDE.md imports ~/.claude/local.md, which holds facts about this machine
# only and is never tracked. Write a stub unless something is already there. A link counts
# even when it points nowhere (`-e` alone misses that), so nothing is written through one.
local_facts="$HOME/.claude/local.md"
if [ ! -e "$local_facts" ] && [ ! -L "$local_facts" ]; then
  cat >"$local_facts" <<'EOF' || die "could not write $local_facts"
# This machine

Facts about this machine only: OS, shell, paths, installed tools, network.
`~/.claude/CLAUDE.md` imports this file; the dotfiles don't track it.
EOF
fi

# install_plugins <file> — runs `claude plugin install <plugin> --marketplace <marketplace>
# --scope user` for each "<plugin> <marketplace>" line, in file order, unless the list is
# empty. Checks every line before the first call. The calls run outside the read loop, so
# claude keeps the script's own stdin: it may show a command for a person to confirm.
install_plugins() {
  local list="$1" lines=() line plugin marketplace extra
  while IFS= read -r line; do
    read -r plugin marketplace extra <<<"$line"
    if [ -z "$marketplace" ] || [ -n "$extra" ]; then
      die "bad line in $list: '$line'. Each line must be: <plugin> <marketplace>"
    fi
    lines+=("$line")
  done < <(read_list "$list")
  [ "${#lines[@]}" -gt 0 ] || return 0

  command -v claude >/dev/null \
    || die "claude not found on PATH; $list needs it. Install Claude Code, then re-run."
  for line in "${lines[@]}"; do
    read -r plugin marketplace <<<"$line"
    claude plugin install "$plugin" --marketplace "$marketplace" --scope user \
      || die "claude plugin install $plugin --marketplace $marketplace --scope user failed for $list"
  done
}

install_plugins "$plugin_list"

# register_mcp_servers <file> — runs `claude mcp add --scope user <name> -- <command>
# [args...]` for each "<name> <command> [args...]" line, in file order, unless the list is
# empty. A line is split on whitespace; there is no quoting. Checks every line before the
# first call. Skips a name that `claude mcp get` finds, because adding it again fails.
# Stops at a command that isn't on PATH: a server registered without one can't start.
register_mcp_servers() {
  local list="$1" lines=() line fields name
  while IFS= read -r line; do
    read -r -a fields <<<"$line"
    if [ "${#fields[@]}" -lt 2 ]; then
      die "bad line in $list: '$line'. Each line must be: <name> <command> [args...]"
    fi
    lines+=("$line")
  done < <(read_list "$list")
  [ "${#lines[@]}" -gt 0 ] || return 0

  command -v claude >/dev/null \
    || die "claude not found on PATH; $list needs it. Install Claude Code, then re-run."
  for line in "${lines[@]}"; do
    read -r -a fields <<<"$line"
    name="${fields[0]}"
    command -v "${fields[1]}" >/dev/null \
      || die "${fields[1]} not found on PATH; MCP server $name in $list runs it. Install it (the comments in that file say how), then re-run."
    claude mcp get "$name" >/dev/null 2>&1 && continue
    claude mcp add --scope user "$name" -- "${fields[@]:1}" \
      || die "claude mcp add --scope user $name -- ${fields[*]:1} failed for $list"
  done
}

register_mcp_servers "$mcp_list"
